# Environment mode
ENVIRONMENT=development
DEBUG=True

# JWT Auth
SECRET_KEY=supersecret-fraudgraph-jwt-key-2026-viva-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin and Analyst credentials for viva / evaluation
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=analystpassword123

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_DOCKER_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudgraphpassword
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# PostgreSQL (benchmark database)
POSTGRES_USER=frauduser
POSTGRES_PASSWORD=fraudpassword
POSTGRES_DB=fraudgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DOCKER_HOST=postgres
POSTGRES_DOCKER_PORT=5432

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8008
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3008","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3008"]

# Frontend Next.js
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8008
